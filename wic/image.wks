#
# idbloader / U-Boot SPL
#
part idbloader  --offset 32K  --fixed-size 4M --no-table --align 1 --source rawcopy --sourceparams="file=${SPL_BINARY}"

#
# U-Boot proper
#
part u-boot     --offset 8M   --fixed-size 4M --no-table --align 1 --source rawcopy --sourceparams="file=u-boot.${UBOOT_SUFFIX}"

#
# Partition Table (GPT)
#
#    Partition      Start      Size        Description
#    -----------    -------    --------    ----------------
#    config         12M        128M        config
#    /              140M       6G          rootfs (extended at bootup)
#    user           6284M      -           user (created at bootup)
#
part config     --offset 12M    --fixed-size 128M --label config --fstype=ext4 --part-name config --source bootimg-partition --align 1024
part /          --offset 140M   --label rootfs --active --fstype=ext4 --part-name rootfs --source rootfs --uuid="${ROOT_PARTUUID}" --align 1024

bootloader --ptable gpt
