From 1fb0d85d5300ab8a046aab5d277272af3e762502 Mon Sep 17 00:00:00 2001
From: lakabd <lakbir.abder@gmail.com>
Date: Tue, 2 Dec 2025 20:39:20 +0100
Subject: [PATCH] Fix build in yocto

---
 CMakeLists.txt                 | 4 +++-
 iq_parser_v2/CMakeLists.txt    | 2 +-
 rkaiq_3A_server/CMakeLists.txt | 6 +++---
 3 files changed, 7 insertions(+), 5 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 9e324032e61b..3e0c8db3fcdd 100755
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -374,7 +374,9 @@ endif()
 
 add_subdirectory(rkaiq_3A_server)
 
-add_subdirectory(tests/rkisp_demo)
+# depends on rga library 
+#add_subdirectory(tests/rkisp_demo)
+#
 
 cmake_policy(SET CMP0015 NEW)
 
diff --git a/iq_parser_v2/CMakeLists.txt b/iq_parser_v2/CMakeLists.txt
index 9248bce15b3b..f029248b38a3 100644
--- a/iq_parser_v2/CMakeLists.txt
+++ b/iq_parser_v2/CMakeLists.txt
@@ -12,7 +12,7 @@ set(J2S_SRC
 #########################################################
 add_custom_command(
     OUTPUT ${CMAKE_CURRENT_BINARY_DIR}/output.h
-    COMMAND ${CMAKE_C_COMPILER}
+    COMMAND ${CMAKE_C_COMPILER} --sysroot=${CMAKE_SYSROOT}  # CMake does not automatically add --sysroot to add_custom_command
     ${CMAKE_SOURCE_DIR}/include/iq_parser_v2/RkAiqCalibDbTypesV2.h -E -C -o .temp.h ${ISP_HW_VERSION}
     -I${CMAKE_SOURCE_DIR}/
     -I${CMAKE_SOURCE_DIR}/include
diff --git a/rkaiq_3A_server/CMakeLists.txt b/rkaiq_3A_server/CMakeLists.txt
index fcc68b3ee5a8..b4288039e386 100644
--- a/rkaiq_3A_server/CMakeLists.txt
+++ b/rkaiq_3A_server/CMakeLists.txt
@@ -109,11 +109,11 @@ if(BUILDROOT_BUILD_PROJECT)
 		WORLD_EXECUTE WORLD_READ)
 else()
 	install(TARGETS rkaiq_3A_server
-		RUNTIME DESTINATION "usr/bin"
-		LIBRARY DESTINATION "usr/lib"
+		RUNTIME DESTINATION "${CMAKE_INSTALL_BINDIR}" # fix do_install
+		LIBRARY DESTINATION "${CMAKE_INSTALL_LIBDIR}"
 		)
 
-	install(FILES S40rkaiq_3A DESTINATION "etc/init.d"
+	install(FILES S40rkaiq_3A DESTINATION "${CMAKE_INSTALL_SYSCONFDIR}/init.d"
 		PERMISSIONS OWNER_EXECUTE OWNER_WRITE OWNER_READ
 		GROUP_EXECUTE GROUP_READ
 		WORLD_EXECUTE WORLD_READ)
-- 
2.34.1

